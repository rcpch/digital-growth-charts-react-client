/*******************************
         Site Overrides
*******************************/

/* Ensure no green flash and consistent pressed/focus styles app-wide */
.ui.toggle.buttons .button.active,
.ui.toggle.button.active {
  background: #000 !important;
  color: #fff !important;
  border-color: #000 !important;
}

.ui.buttons .button:active,
.ui.button:active,
.ui.buttons .button:focus,
.ui.button:focus {
  background: #e6e6e6 !important;
  color: #000 !important;
  border-color: #d4d4d5 !important;
  box-shadow: none !important;
}

/* Hover styling for preset radio button group - increase specificity for basic buttons */
.ui.basic.buttons.preset-buttons .button:hover,
.ui.buttons.preset-buttons .button:hover,
.ui.basic.button.preset-buttons:hover,
.preset-buttons .button:hover {
  background: #000 !important;
  color: #fff !important;
  border-color: #000 !important;
  box-shadow: none !important;
}