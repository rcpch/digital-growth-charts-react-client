/*******************************
    User Variable Overrides
*******************************/

/* Global colors */
@primaryColor: #000;
@positiveColor: #000;

/* Keep keyboard focus clearly visible. */
@focusBoxShadow: 0 0 0 3px rgba(27, 70, 156, 0.45);
@invertedFocusBoxShadow: 0 0 0 3px rgba(255, 255, 255, 0.8);

/* Toggle (radio-like) buttons: active state is black/white */
@toggleOnBackgroundColor: #000;
@toggleOnTextColor: #fff;
@toggleOnBorderColor: #000;

/* Pressed/clicked (:active) state for non-active buttons */
@downBackgroundColor: #e6e6e6;
@downTextColor: #000;
@downBorderColor: #d4d4d5;
