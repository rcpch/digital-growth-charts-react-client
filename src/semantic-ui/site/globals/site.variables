/*******************************
     User Global Variables
*******************************/
/* Use Vite base for all fonts served from public/fonts */
@fontPath   : '@{basePath}fonts';

/* Ensure icon CSS emits <base>/fonts/... URLs */
@iconFontPath        : '@{basePath}fonts';
@outlineIconFontPath : '@{basePath}fonts';
@brandFontPath       : '@{basePath}fonts';

/* Fonts */
@fontName: 'Montserrat';
@importGoogleFonts: false;

@defaultBorderRadius: 0em;

/* Colours */
@rcpch-nav-actv: #1B469C;
@rcpch-nav: #3366cc;
@rcpch-dark-blue-header: #0d0d58;

@blue: #3366cc;
@pink: #e00087;