  },
  "homepage": "https://rcpch.github.io/digital-growth-charts-react-client",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/browser/** --exclude tests/e2e/**",
    "test:browser": "playwright test",
    "test:e2e-local": "playwright test --config=playwright.e2e.config.js",
    "test:live": "node tests/live/platform-api-smoke.mjs",
    "preview": "vite preview",
    "postinstall": "cp -f \"./src/semantic-ui/theme.config\" \"./node_modules/semantic-ui-less/theme.config\" && mkdir -p ./public/themes/default/assets/fonts && cp -f ./node_modules/semantic-ui-less/themes/default/assets/fonts/* ./public/themes/default/assets/fonts && mkdir -p ./public/themes/default/assets/images && cp -f ./node_modules/semantic-ui-less/themes/default/assets/images/flags.png ./public/themes/default/assets/images/flags.png && mkdir -p ./public/fonts && cp -f ./node_modules/semantic-ui-less/themes/default/assets/fonts/* ./public/fonts"
  },
  "dependencies": {
    "@rcpch/digital-growth-charts-react-component-library": "7.5.2",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semantic-ui-react": "3.0.0-beta.2",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.30",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "globals": "15.15.0",
    "jsdom": "30.0.1",
    "less": "4.9.1",
    "semantic-ui-less": "2.5.0",
    "semver": "7.8.5",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
