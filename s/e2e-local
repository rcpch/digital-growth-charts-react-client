#!/usr/bin/env bash
#
# Run the "local-everything" preset of the E2E compatibility harness
# (see spec/e2e.md): the local rcpchgrowth-python engine inside a locally
# built API server, the local Chart Component source, and this Demo Client
# checkout. Verifies the real API contract and renders the local component
# in Chromium. It does not yet drive a real browser-to-API measurement
# submission; see spec/e2e.md Known Edge Cases and roadmap E2E-R7.
#
# Uses the reserved dGC local/E2E port block 58600-58699 (see spec/e2e.md)
# rather than the API server's own default port 8000, so this can run
# alongside other local services without clashing. This starts the API
# container directly with an explicit port mapping instead of calling the
# server repository's own `s/dev`, because that script's docker-compose.yml
# fixes the host port at 8000; this intentionally does not modify the
# sibling repository.
#
# Requires sibling checkouts of rcpchgrowth-python,
# digital-growth-charts-server, and
# digital-growth-charts-react-component-library, and Docker. Set API_PORT
# and CLIENT_PORT to override the default ports.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

REPO_ROOT="$(pwd)"
SIBLINGS_ROOT="$(cd "$REPO_ROOT/.." && pwd)"
SERVER_DIR="$SIBLINGS_ROOT/digital-growth-charts-server"
ENGINE_DIR="$SIBLINGS_ROOT/rcpchgrowth-python"
COMPONENT_DIR="$SIBLINGS_ROOT/digital-growth-charts-react-component-library"

API_PORT="${API_PORT:-58600}"
API_URL="http://127.0.0.1:${API_PORT}"
CLIENT_PORT="${CLIENT_PORT:-58680}"
CLIENT_URL="http://127.0.0.1:${CLIENT_PORT}"
LOG_DIR="$REPO_ROOT/test-results/e2e-local"
rm -rf "$LOG_DIR"
mkdir -p "$LOG_DIR"

for dir in "$SERVER_DIR" "$ENGINE_DIR" "$COMPONENT_DIR"; do
  if [ ! -d "$dir" ]; then
    echo "ERROR: required sibling checkout not found: $dir" >&2
    echo "The local-everything preset expects rcpchgrowth-python, digital-growth-charts-server, and digital-growth-charts-react-component-library checked out alongside this repository." >&2
    exit 1
  fi
done

API_JOB_PID=""
CLIENT_PID=""
cleanup() {
  local status=$?
  echo "--- Tearing down local-everything stack ---"
  if [ -n "$CLIENT_PID" ]; then
    kill "$CLIENT_PID" 2>/dev/null || true
    wait "$CLIENT_PID" 2>/dev/null || true
  fi
  if [ -n "$API_JOB_PID" ]; then
    kill "$API_JOB_PID" 2>/dev/null || true
    wait "$API_JOB_PID" 2>/dev/null || true
  fi
  # `docker compose run` containers are not managed by `docker compose down`,
  # so remove the run container explicitly before it as a fallback.
  docker ps -aq --filter "name=digital-growth-charts-server-growth-api-run" \
    | xargs -r docker rm -f >>"$LOG_DIR/api-server.log" 2>&1 || true
  ( cd "$SERVER_DIR" && s/down ) >>"$LOG_DIR/api-server.log" 2>&1 || true
  exit "$status"
}
trap cleanup EXIT

wait_for() {
  local url="$1" label="$2" timeout="${3:-180}"
  echo "Waiting for $label at $url (up to ${timeout}s)..."
  for _ in $(seq 1 "$timeout"); do
    if curl -sf -o /dev/null "$url"; then
      echo "$label is up."
      return 0
    fi
    sleep 1
  done
  echo "ERROR: $label did not become ready within ${timeout}s. See $LOG_DIR." >&2
  return 1
}

echo "--- Starting local API server on port $API_PORT with the local rcpchgrowth-python source ---"
( cd "$SERVER_DIR" && docker compose run --rm -p "${API_PORT}:8000" \
    -v "${ENGINE_DIR}:/ext/rcpchgrowth-src" \
    growth-api bash -c '
      set -e
      pip uninstall -y rcpchgrowth >/dev/null 2>&1 || true
      pip install -e /ext/rcpchgrowth-src
      python - <<PY
import rcpchgrowth
print("Loaded (editable) version:", getattr(rcpchgrowth, "__version__", "?"))
print("Module path:", rcpchgrowth.__file__)
PY
      uvicorn main:app --host 0.0.0.0 --port 8000 --reload
    '
) </dev/null >"$LOG_DIR/api-server.log" 2>&1 &
API_JOB_PID=$!
wait_for "$API_URL/" "local API server" 180

echo "--- Verifying the real API contract for all references and mid-parental-height ---"
LIVE_GROWTH_API_BASE_URL="$API_URL" npm run test:live

echo "--- Starting the Demo Client against the local API and local Chart Component source ---"
# Bypass the `dev` npm script's own --port 3000 and bind explicitly to the
# IPv4 loopback: Vite's default --host binds only [::1] in this environment,
# which the IPv4-explicit readiness check and Playwright baseURL cannot reach.
NODE_ENV=development VITE_APP_GROWTH_API_BASEURL="$API_URL" \
  npx vite --port "$CLIENT_PORT" --host 127.0.0.1 >"$LOG_DIR/client.log" 2>&1 &
CLIENT_PID=$!
wait_for "$CLIENT_URL/" "Demo Client dev server" 60

echo "--- Rendering the local Chart Component in Chromium ---"
E2E_CLIENT_BASE_URL="$CLIENT_URL" npx playwright test --config=playwright.e2e.config.js

echo "--- local-everything: nothing broke ---"
