#!/usr/bin/env bash
#
# Stop and remove the local Docker Compose development environment.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! docker compose version >/dev/null 2>&1; then
  printf 'Docker Compose is required. Install Docker with the Compose plugin before running s/down.\n' >&2
  exit 1
fi

exec docker compose down "$@"
