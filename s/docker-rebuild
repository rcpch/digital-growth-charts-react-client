#!/usr/bin/env bash
#
# Rebuild the local development image. Run it afterward with s/docker-start.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

image="rcpch-dgc-demo-client"

if ! command -v docker >/dev/null 2>&1; then
  printf 'Docker is required. Install it before running s/docker-rebuild.\n' >&2
  exit 1
fi

exec docker build --tag "${image}" "$@" .
