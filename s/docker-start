#!/usr/bin/env bash
#
# Run the previously built local development image. Create .env from
# example.env first, and build the image with s/docker-rebuild.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

app="rcpch-dgc-demo-client"

if ! command -v docker >/dev/null 2>&1; then
  printf 'Docker is required. Install it before running s/docker-start.\n' >&2
  exit 1
fi

if [[ ! -f .env ]]; then
  printf 'Missing .env. Run: cp example.env .env\n' >&2
  exit 1
fi

exec docker run -it --rm -p 3000:3000 \
  --name="${app}" \
  --volume "${PWD}:/app" \
  --volume /app/node_modules \
  --env-file ./.env \
  "$@" \
  "${app}"
